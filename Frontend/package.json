{
  "name": "e-disiplin-asn",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "server:dev": "cd server && node src/server.js",
    "server:start": "cd server && NODE_ENV=production node src/server.js",
    "db:seed": "cd server && node src/database/seed.js",
    "db:seed:extra": "cd server && node src/database/extra-seed.js",
    "db:seed:all": "cd server && node src/database/seed.js && node src/database/extra-seed.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v && docker compose up -d"
  },
  "devDependencies": {
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.57.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  }
}
