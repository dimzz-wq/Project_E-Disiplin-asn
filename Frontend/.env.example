# ════════════════════════════════════════════════════════════
# E-Disiplin ASN — Environment Variables
# ════════════════════════════════════════════════════════════
# PETUNJUK:
#   1. Salin file ini → .env
#   2. Isi semua nilai yang ditandai <GANTI_...>
#   3. JANGAN commit file .env ke Git!
# ════════════════════════════════════════════════════════════

# ── Aplikasi ─────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# Port yang diexpose ke host (untuk docker-compose)
APP_PORT=5000

# ── Database MySQL ────────────────────────────────────────
DB_ROOT_PASSWORD=<GANTI_ROOT_PASSWORD>
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=<GANTI_DB_USER>
DB_PASSWORD=<GANTI_DB_PASSWORD>
DB_NAME=edisiplin_asn

# ── JWT Secret — WAJIB GANTI! ────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<GANTI_JWT_SECRET_MIN_64_CHAR>
JWT_REFRESH_SECRET=<GANTI_REFRESH_SECRET_MIN_64_CHAR>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Upload ────────────────────────────────────────────────
UPLOAD_DIR=./uploads
