{
  "name": "e-disiplin-asn-server",
  "version": "1.0.0",
  "description": "Backend API for E-Disiplin ASN",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "NODE_ENV=production node src/server.js",
