# ── E-Disiplin ASN — Production Environment ──────────────────
# SALIN file ini ke server produksi sebagai: server/.env
# Ganti semua nilai sesuai konfigurasi server Anda
# JANGAN commit file ini ke Git!

PORT=5000
NODE_ENV=production

# ── Database PostgreSQL ─────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_ANDA
DB_NAME=edisiplin_asn

# ── JWT — WAJIB ganti dengan key acak yang panjang! ────────────
# Gunakan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GANTI_JWT_SECRET_MINIMAL_64_KARAKTER_ACAK
JWT_REFRESH_SECRET=GANTI_REFRESH_SECRET_MINIMAL_64_KARAKTER_ACAK
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── URL Aplikasi (opsional jika frontend & backend satu domain) ─
# Isi jika frontend di domain berbeda, kosongkan jika satu server
# CLIENT_URL=https://edisiplin.instansi.go.id

# ── Upload folder ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
